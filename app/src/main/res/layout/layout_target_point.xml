<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 十字准星图标（触控类型为每个目标自己的属性：编辑模式下点按目标切换） -->
    <ImageView
        android:id="@+id/iv_target_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_crosshair"
        android:contentDescription="目标点"
        android:scaleType="fitXY" />

    <!-- 触控类型角标：绿色=单次触控，橙色=持续触控；仅编辑模式显示 -->
    <View
        android:id="@+id/v_target_type_badge"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_type_badge"
        android:visibility="gone" />

</FrameLayout>

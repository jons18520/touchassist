<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 单次触控目标：间隔时间（全局） -->
    <TextView
        android:id="@+id/tv_interval_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/click_interval_label"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_interval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="100"
        android:inputType="number"
        android:text="100" />

    <!-- 持续触控目标：推动距离（全局） -->
    <TextView
        android:id="@+id/tv_swipe_distance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/swipe_distance_label"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_swipe_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="0"
        android:inputType="number"
        android:text="0" />

    <!-- 持续触控目标：滑动方向（全局） -->
    <TextView
        android:id="@+id/tv_swipe_direction_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/swipe_direction_label"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_swipe_direction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_dir_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/swipe_direction_up" />

        <RadioButton
            android:id="@+id/rb_dir_down"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/swipe_direction_down" />

        <RadioButton
            android:id="@+id/rb_dir_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/swipe_direction_left" />

        <RadioButton
            android:id="@+id/rb_dir_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/swipe_direction_right" />

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/target_type_hint"
        android:textSize="12sp" />

</LinearLayout>
